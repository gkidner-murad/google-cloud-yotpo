PORT=8080

# Yotpo Loyalty API credentials (Yotpo Loyalty dashboard > Settings > General Settings)
YOTPO_GUID=your-guid-here
YOTPO_API_KEY=your-api-key-here
YOTPO_API_BASE_URL=https://loyalty.yotpo.com/api/v2

# Shared secret the browser must send as the x-api-key header
PROXY_API_KEY=shared-secret-for-browser-callers

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://www.murad.com
